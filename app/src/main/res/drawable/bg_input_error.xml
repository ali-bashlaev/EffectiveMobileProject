<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep the same dark background as your normal field -->
    <solid android:color="@color/bg_dark" />

    <!-- Add a red border to indicate an error -->
    <stroke
        android:width="1dp"
        android:color="#FF4B4B" /> <!-- Red color -->

    <!-- Match the corner radius of your other inputs -->
    <corners android:radius="8dp" />
</shape>